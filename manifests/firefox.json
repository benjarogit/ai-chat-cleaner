{
  "manifest_version": 3,
  "name": "AI Chat Cleaner",
  "short_name": "ACC",
  "version": "1.1.0",
  "description": "Bulk-delete chats on Claude, ChatGPT, Gemini, Grok, GitHub Copilot, Microsoft Copilot, and Cursor. Firefox + Android",
  "author": "Sunny C.",
  "homepage_url": "https://sunnyc.de",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AI Chat Cleaner",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://myactivity.google.com/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://x.com/*",
    "https://github.com/copilot*",
    "https://api.individual.githubcopilot.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://cursor.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://myactivity.google.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://x.com/i/grok*",
        "https://x.com/settings/*",
        "https://github.com/copilot*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://cursor.com/agents*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["page-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aichatcleaner@sunnyc.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
